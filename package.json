{
  "name": "nextreset",
  "version": "1.0.0",
  "description": "Automated game countdown and status tracking website",
  "main": "dist/refresh-all.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "node build/run-tests.js",
    "ai:eval": "node build/v2/ai/eval.js",
    "slice:lol": "node build/v2/tools/run-slice.js lol next-patch",
    "ai:eval:live": "node build/v2/ai/eval.js --live",
    "refresh:data": "node build/refresh-all.js",
    "export:site": "node build/export-site.js",
    "render:pages": "node build/render-pages.js",
    "build:site": "npm run build && (npm run refresh:data || true) && npm run export:site && npm run render:pages",
    "dev": "npm run build && npm run refresh:data",
    "design:apply": "node build/update-design.js"
  },
  "keywords": [
    "gaming",
    "countdown",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "cheerio": "^1.0.0-rc.12",
    "fast-xml-parser": "^4.3.2",
    "node-fetch": "^2.7.0",
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.9",
    "typescript": "^5.3.3"
  }
}
